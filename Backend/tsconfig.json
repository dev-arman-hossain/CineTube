{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2023",
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "prisma/**/*",
    "./"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}